<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TaskbarLyriz.App.Pages.LyricsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:TaskbarLyriz.App.ViewModels"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <Grid Padding="32,24,32,32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Lyrics" />
                <TextBlock
                    Style="{StaticResource PageSubtitleStyle}"
                    Text="Live synchronized lyrics from the current Windows media session." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                <Button Click="Refresh_Click" Content="Refresh" />
            </StackPanel>
        </Grid>

        <InfoBar
            Grid.Row="1"
            IsClosable="False"
            IsOpen="True"
            Message="{x:Bind ViewModel.Status, Mode=OneWay}" />

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="5">
                    <TextBlock
                        FontSize="24"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="{x:Bind ViewModel.Artist, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="4">
                    <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Text="{x:Bind ViewModel.LyricsKind, Mode=OneWay}" />
                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource PageSubtitleStyle}" Text="{x:Bind ViewModel.Source, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border
            Grid.Row="3"
            Style="{StaticResource CardStyle}"
            Visibility="{x:Bind ViewModel.SynchronizationVisibility, Mode=OneWay}">
            <StackPanel Spacing="12">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE768;" />
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.SynchronizationStatus, Mode=OneWay}" />
                        <TextBlock Opacity="0.65" Text="{x:Bind ViewModel.PlaybackStatus, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock
                        HorizontalAlignment="Right"
                        Text="{x:Bind ViewModel.PlaybackPosition, Mode=OneWay}" />
                </Grid>

                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="{x:Bind ViewModel.LyricFontFamily, Mode=OneWay}"
                    Opacity="0.55"
                    Text="{x:Bind ViewModel.PreviousLine, Mode=OneWay}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="CurrentLyricText"
                    FontFamily="{x:Bind ViewModel.LyricFontFamily, Mode=OneWay}"
                    FontSize="{x:Bind ViewModel.CurrentLyricFontSize, Mode=OneWay}"
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.CurrentLine, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="Wrap">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="CurrentLyricTranslate" />
                    </TextBlock.RenderTransform>
                </TextBlock>
                <ProgressBar
                    Height="3"
                    Maximum="1"
                    Value="{x:Bind ViewModel.LineProgress, Mode=OneWay}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="{x:Bind ViewModel.LyricFontFamily, Mode=OneWay}"
                    Opacity="0.72"
                    Text="{x:Bind ViewModel.NextLine, Mode=OneWay}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis" />

                <Grid Margin="0,4,0,0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock VerticalAlignment="Center" Text="Timing" />
                        <Button Click="OffsetEarlier_Click" Content="-250 ms" />
                        <Button Click="OffsetReset_Click" Content="Reset" />
                        <Button Click="OffsetLater_Click" Content="+250 ms" />
                        <TextBlock
                            MinWidth="62"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.TimingOffsetText, Mode=OneWay}" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="FollowCurrentLineToggle"
                        Grid.Column="1"
                        Header="Follow current line"
                        IsOn="{x:Bind ViewModel.FollowCurrentLine, Mode=OneWay}"
                        Toggled="FollowCurrentLine_Toggled" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Padding="4" BorderThickness="1" CornerRadius="12">
            <ListView
                x:Name="LyricsList"
                FontFamily="{x:Bind ViewModel.LyricFontFamily, Mode=OneWay}"
                ItemsSource="{x:Bind ViewModel.Lines, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:LyricDisplayLine">
                        <Grid
                            Padding="16,10"
                            ColumnSpacing="20"
                            Opacity="{x:Bind Opacity, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Opacity="0.72"
                                Text="{x:Bind Timestamp}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="1"
                                AutomationProperties.Name="{x:Bind Text}"
                                FontSize="{x:Bind FontSize, Mode=OneWay}"
                                Text="{x:Bind Text}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
