<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TaskbarLyriz.App.Pages.TaskbarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">
    <ScrollViewer>
        <StackPanel
            MaxWidth="820"
            Padding="32,24,32,40"
            HorizontalAlignment="Stretch"
            Spacing="24">
            <StackPanel Spacing="6">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Taskbar lyrics" />
                <TextBlock
                    Style="{StaticResource PageSubtitleStyle}"
                    Text="Keep the synchronized line in a quiet, non-activating surface inside unused taskbar space." />
            </StackPanel>

            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="This first taskbar experience uses an unused gap inside the bottom taskbar on the primary monitor. It never injects into or modifies Explorer."
                Severity="Informational"
                Title="Safe Windows integration" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="22">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock FontWeight="SemiBold" Text="Show taskbar lyrics" />
                            <TextBlock
                                Style="{StaticResource PageSubtitleStyle}"
                                Text="Shows automatically for synchronized playing or paused tracks and hides when inactive." />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            AutomationProperties.Name="Show taskbar lyrics"
                            IsOn="{x:Bind ViewModel.TaskbarLyricsEnabled, Mode=OneWay}"
                            Toggled="TaskbarLyrics_Toggled" />
                    </Grid>

                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock FontWeight="SemiBold" Text="Position" />
                            <TextBlock
                                Style="{StaticResource PageSubtitleStyle}"
                                Text="Use the free gap left or right of the centered app buttons. Left matches the space beside Weather." />
                        </StackPanel>
                        <ComboBox
                            x:Name="PositionPicker"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Taskbar lyrics position"
                            SelectedIndex="{x:Bind ViewModel.TaskbarPositionIndex, Mode=OneWay}"
                            SelectionChanged="PositionPicker_SelectionChanged">
                            <ComboBoxItem Content="Left" />
                            <ComboBoxItem Content="Right" />
                        </ComboBox>
                    </Grid>

                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock FontWeight="SemiBold" Text="Surface width" />
                            <TextBlock
                                Style="{StaticResource PageSubtitleStyle}"
                                Text="Preferred width in view pixels; the surface is clamped to the detected unused taskbar gap." />
                        </StackPanel>
                        <NumberBox
                            x:Name="WidthBox"
                            Grid.Column="1"
                            AutomationProperties.Name="Taskbar lyrics width"
                            Header="View pixels"
                            Maximum="1200"
                            Minimum="160"
                            SmallChange="20"
                            SpinButtonPlacementMode="Inline"
                            Value="{x:Bind ViewModel.TaskbarWidth, Mode=OneWay}"
                            ValueChanged="WidthBox_ValueChanged" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Milestone 5 behavior" />
                    <TextBlock Text="&#x2022; Borderless window with WS_EX_NOACTIVATE" />
                    <TextBlock Text="&#x2022; Hidden from Alt+Tab with WS_EX_TOOLWINDOW" />
                    <TextBlock Text="&#x2022; Click-through window that cannot block taskbar input" />
                    <TextBlock Text="&#x2022; Positioned from live taskbar, app-strip, and notification-area geometry" />
                    <TextBlock Text="&#x2022; Hides when no safe unused taskbar gap is available" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
