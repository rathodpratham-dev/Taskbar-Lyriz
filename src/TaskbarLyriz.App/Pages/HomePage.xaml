<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TaskbarLyriz.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel
            MaxWidth="1080"
            Padding="32,24,32,40"
            HorizontalAlignment="Stretch"
            Spacing="24">
            <StackPanel Spacing="6">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Now playing" />
                <TextBlock
                    Style="{StaticResource PageSubtitleStyle}"
                    Text="TaskbarLyriz follows the media session Windows considers current." />
            </StackPanel>

            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind ViewModel.ServiceStatus, Mode=OneWay}" />

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="176" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="176" Height="176">
                        <Border Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="16">
                            <FontIcon
                                FontSize="58"
                                Glyph="&#xE8D6;"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <Border CornerRadius="16">
                            <Image Source="{x:Bind ViewModel.Artwork, Mode=OneWay}" Stretch="UniformToFill" />
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="9">
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Text="{x:Bind ViewModel.Player, Mode=OneWay}" />
                        <TextBlock
                            FontSize="28"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="{x:Bind ViewModel.Artist, Mode=OneWay}" />
                        <ProgressBar
                            Margin="0,12,0,0"
                            Maximum="{x:Bind ViewModel.ProgressMaximum, Mode=OneWay}"
                            Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" />
                        <Grid>
                            <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="{x:Bind ViewModel.Position, Mode=OneWay}" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                Style="{StaticResource PageSubtitleStyle}"
                                Text="{x:Bind ViewModel.Duration, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Style="{StaticResource CardStyle}"
                Visibility="{x:Bind Lyrics.SynchronizationVisibility, Mode=OneWay}">
                <StackPanel Spacing="10">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8D2;" />
                            <TextBlock FontWeight="SemiBold" Text="LIVE LYRICS" />
                            <TextBlock Opacity="0.65" Text="{x:Bind Lyrics.SynchronizationStatus, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock
                            HorizontalAlignment="Right"
                            Opacity="0.72"
                            Text="{x:Bind Lyrics.TimingOffsetText, Mode=OneWay}" />
                    </Grid>
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontFamily="{x:Bind Lyrics.LyricFontFamily, Mode=OneWay}"
                        Opacity="0.55"
                        Text="{x:Bind Lyrics.PreviousLine, Mode=OneWay}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        FontFamily="{x:Bind Lyrics.LyricFontFamily, Mode=OneWay}"
                        FontSize="{x:Bind Lyrics.CurrentLyricFontSize, Mode=OneWay}"
                        FontWeight="SemiBold"
                        Text="{x:Bind Lyrics.CurrentLine, Mode=OneWay}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <ProgressBar Height="3" Maximum="1" Value="{x:Bind Lyrics.LineProgress, Mode=OneWay}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontFamily="{x:Bind Lyrics.LyricFontFamily, Mode=OneWay}"
                        Opacity="0.72"
                        Text="{x:Bind Lyrics.NextLine, Mode=OneWay}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="System status" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE73E;" HorizontalAlignment="Left" />
                        <TextBlock FontWeight="SemiBold" Text="Native shell" />
                        <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="Ready" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE77F;" HorizontalAlignment="Left" />
                        <TextBlock FontWeight="SemiBold" Text="Media session" />
                        <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="{x:Bind ViewModel.SessionCount, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE7F4;" HorizontalAlignment="Left" />
                        <TextBlock FontWeight="SemiBold" Text="Taskbar lyrics" />
                        <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="Planned safely" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
