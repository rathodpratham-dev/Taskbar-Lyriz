<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TaskbarLyriz.App.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel
            MaxWidth="760"
            Padding="32,24,32,40"
            HorizontalAlignment="Stretch"
            Spacing="24">
            <StackPanel Spacing="6">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="About TaskbarLyriz" />
                <TextBlock
                    Style="{StaticResource PageSubtitleStyle}"
                    Text="A quiet, native Windows companion for synchronized lyrics." />
            </StackPanel>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <FontIcon FontSize="48" Glyph="&#xE8D6;" HorizontalAlignment="Left" />
                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="TaskbarLyriz" />
                    <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="Version 0.5.0 &#x2014; Taskbar experience milestone" />
                    <TextBlock
                        TextWrapping="Wrap"
                        Text="Built with C#, .NET 10, WinUI 3, the Windows App SDK, and documented Windows APIs. TaskbarLyriz does not inject into Explorer or modify system binaries." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
