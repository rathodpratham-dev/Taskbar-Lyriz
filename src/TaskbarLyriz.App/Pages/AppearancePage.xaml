<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TaskbarLyriz.App.Pages.AppearancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">
    <ScrollViewer>
        <StackPanel
            MaxWidth="900"
            Padding="32,24,32,40"
            HorizontalAlignment="Stretch"
            Spacing="24">
            <StackPanel Spacing="6">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Appearance" />
                <TextBlock
                    Style="{StaticResource PageSubtitleStyle}"
                    Text="Tune the lyric surface to fit naturally with your Windows taskbar." />
            </StackPanel>

            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="Changes save automatically and update the taskbar lyrics immediately."
                Severity="Informational"
                Title="Live preview" />

            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Preview" />
                <Border
                    Padding="22"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    CornerRadius="12">
                    <Border
                        x:Name="PreviewSurface"
                        MaxWidth="560"
                        Padding="12,8"
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="{x:Bind ViewModel.PreviewCornerRadius, Mode=OneWay}"
                        Opacity="{x:Bind ViewModel.PreviewOpacity, Mode=OneWay}">
                        <StackPanel Spacing="5">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE8D6;" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{x:Bind ViewModel.LyricFontFamily, Mode=OneWay}"
                                    FontSize="{x:Bind ViewModel.LyricFontSize, Mode=OneWay}"
                                    FontWeight="SemiBold"
                                    Text="Look at them Bonnies on the run"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <ProgressBar Height="2" Maximum="1" Value="0.58" />
                        </StackPanel>
                    </Border>
                </Border>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Colors and transparency" />
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="20">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="App theme" />
                                <TextBlock
                                    Style="{StaticResource PageSubtitleStyle}"
                                    Text="Follow Windows or choose a fixed light or dark theme." />
                            </StackPanel>
                            <ComboBox
                                x:Name="ThemePicker"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="App theme"
                                SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=OneWay}"
                                SelectionChanged="ThemePicker_SelectionChanged">
                                <ComboBoxItem Content="Use system setting" />
                                <ComboBoxItem Content="Light" />
                                <ComboBoxItem Content="Dark" />
                            </ComboBox>
                        </Grid>
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="Taskbar surface opacity" />
                                <TextBlock
                                    Style="{StaticResource PageSubtitleStyle}"
                                    Text="Choose how strongly the lyric background appears over the taskbar." />
                            </StackPanel>
                            <Slider
                                x:Name="OpacitySlider"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Taskbar surface opacity"
                                Maximum="100"
                                Minimum="40"
                                SmallChange="1"
                                StepFrequency="1"
                                Value="{x:Bind ViewModel.AppearanceOpacityPercent, Mode=OneWay}"
                                ValueChanged="OpacitySlider_ValueChanged" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Lyric typography" />
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="20">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="Font" />
                                <TextBlock
                                    Style="{StaticResource PageSubtitleStyle}"
                                    Text="Applied to taskbar lyrics and lyrics inside the app." />
                            </StackPanel>
                            <ComboBox
                                x:Name="FontPicker"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="Lyric font"
                                FontFamily="{x:Bind ViewModel.LyricFontFamily, Mode=OneWay}"
                                SelectedIndex="{x:Bind ViewModel.FontFamilyIndex, Mode=OneWay}"
                                SelectionChanged="FontPicker_SelectionChanged">
                                <ComboBoxItem Content="Segoe UI Variable Text" />
                                <ComboBoxItem Content="Segoe UI" />
                                <ComboBoxItem Content="Arial" />
                                <ComboBoxItem Content="Calibri" />
                                <ComboBoxItem Content="Consolas" />
                            </ComboBox>
                        </Grid>
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="Font size" />
                                <TextBlock
                                    Style="{StaticResource PageSubtitleStyle}"
                                    Text="The taskbar line uses this exact size; in-app lyrics scale proportionally." />
                            </StackPanel>
                            <NumberBox
                                x:Name="FontSizeBox"
                                Grid.Column="1"
                                AutomationProperties.Name="Lyric font size"
                                Header="View pixels"
                                Maximum="36"
                                Minimum="10"
                                SmallChange="1"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.LyricFontSize, Mode=OneWay}"
                                ValueChanged="FontSizeBox_ValueChanged" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Shape and motion" />
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="20">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="Corner radius" />
                                <TextBlock
                                    Style="{StaticResource PageSubtitleStyle}"
                                    Text="Use zero for square corners or increase it for a softer surface." />
                            </StackPanel>
                            <NumberBox
                                x:Name="CornerRadiusBox"
                                Grid.Column="1"
                                AutomationProperties.Name="Taskbar surface corner radius"
                                Header="View pixels"
                                Maximum="32"
                                Minimum="0"
                                SmallChange="1"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.AppearanceCornerRadius, Mode=OneWay}"
                                ValueChanged="CornerRadiusBox_ValueChanged" />
                        </Grid>
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="Line change style" />
                                <TextBlock
                                    Style="{StaticResource PageSubtitleStyle}"
                                    Text="Karaoke keeps the progress underline and adds a gentle entrance." />
                            </StackPanel>
                            <ComboBox
                                x:Name="AnimationPicker"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="Lyric line change style"
                                SelectedIndex="{x:Bind ViewModel.AnimationIndex, Mode=OneWay}"
                                SelectionChanged="AnimationPicker_SelectionChanged">
                                <ComboBoxItem Content="None" />
                                <ComboBoxItem Content="Fade" />
                                <ComboBoxItem Content="Slide" />
                                <ComboBoxItem Content="Karaoke" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
