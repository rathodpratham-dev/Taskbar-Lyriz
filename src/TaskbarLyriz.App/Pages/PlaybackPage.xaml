<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TaskbarLyriz.App.Pages.PlaybackPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel
            MaxWidth="900"
            Padding="32,24,32,40"
            HorizontalAlignment="Stretch"
            Spacing="24">
            <StackPanel Spacing="6">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Playback diagnostics" />
                <TextBlock
                    Style="{StaticResource PageSubtitleStyle}"
                    Text="Live metadata from Global System Media Transport Controls (GSMTC)." />
            </StackPanel>

            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind ViewModel.ServiceStatus, Mode=OneWay}"
                Title="Windows media session" />

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="128" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="128" Height="128">
                        <Border Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="12">
                            <FontIcon FontSize="42" Glyph="&#xE8D6;" />
                        </Border>
                        <Border CornerRadius="12">
                            <Image Source="{x:Bind ViewModel.Artwork, Mode=OneWay}" Stretch="UniformToFill" />
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                        <TextBlock FontSize="13" FontWeight="SemiBold" Text="ACTIVE MEDIA" />
                        <TextBlock FontSize="24" FontWeight="SemiBold" Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="{x:Bind ViewModel.Artist, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="{x:Bind ViewModel.Album, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="Player" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{x:Bind ViewModel.Player, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="Status" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{x:Bind ViewModel.PlaybackStatus, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="Position" />
                            <TextBlock HorizontalAlignment="Right" Text="{x:Bind ViewModel.Position, Mode=OneWay}" />
                        </Grid>
                        <ProgressBar
                            Maximum="{x:Bind ViewModel.ProgressMaximum, Mode=OneWay}"
                            Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" />
                        <Grid>
                            <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="00:00" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                Style="{StaticResource PageSubtitleStyle}"
                                Text="{x:Bind ViewModel.Duration, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Session identity" />
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="Source application" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SourceApplicationId, Mode=OneWay}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="TaskbarLyriz session" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SessionId, Mode=OneWay}" />
                        </Grid>
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="Available sessions" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SessionCount, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
