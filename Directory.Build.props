<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <VersionPrefix>1.0.0</VersionPrefix>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Product>TaskbarLyriz</Product>
    <Company>TaskbarLyriz</Company>
    <Authors>TaskbarLyriz contributors</Authors>
    <Description>Native synchronized lyrics for the Windows taskbar.</Description>
    <Copyright>Copyright © 2026 TaskbarLyriz contributors</Copyright>
  </PropertyGroup>
</Project>
